; === Kernel ===

@data
!dir_start dq #150
!dir_count dq #10
!temp_ram_buffer dq #0x20000 ; Temp buffer to read directory
!trampoline_ram dq #0x60000 ; High rRam

; target file name: "init.hlol"
!target_name_1 dq #0x6F6C682E74696E69 ; "init.hlo"
!target_name_2 dq #0x000000000000006C ; "l\0\0\0\0\0\0\0" Null padding

@text
; === Load the directory from table into bank 1 ===
.LDI $2 !dir_start
.LDQ $2 $2 ; $2 = 150 (dir start)

.LDI $3 !dir_count
.LDQ $3 $3 ; $3 = 10 (dir count)

.LDI $4 !temp_ram_buffer
.LDQ $4 $4 ; $4 = 0x20000 (RAM Target)

.DTM $4 $2 $3 ; Read directory disk sectors to bank 1

; == Initialize Search Loop =
.LDI $5 !target_name_1
.LDQ $5 $5 ; $5 = target name part 1
.LDI $6 !target_name_2
.LDQ $6 $6 ; $6 = target name part 2

.LDI $7 #0 ; $7 = current entry
.LDI $3 #80 ; $3 = max entries

:search_loop
.JEQ :file_not_found $7 $3 ; If searched all entries, halt

; Calculate ram offset
.LDI $2 #6
.SHL $4 $7 $2
.LDI $2 !temp_ram_buffer
.LDQ $2 $2
.ADD $4 $4 $2

; Read entry filename
.LDQ $2 $4
.LDI $0 #8
.ADD $0 $0 $4
.LDQ $0 $0

; Compare name
.JEQ :check_part_two $2 $5
.JMP :next_entry

:check_part_two
.JEQ :file_found $0 $6

:next_entry
.INC $7
.JMP :search_loop

; == File found: prepare trampoline ==
:file_found
.LDI $2 #16
.ADD $2 $2 $4
.LDQ $5 $2

.LDI $2 #32
.ADD $2 $2 $4
.LDQ $6 $2

; Write trampoline to bank 3
.LDI $2 !trampoline_ram
.LDQ $2 $2

; Instruction 1: load init.hlol to address 0
.STQ $4 $2 ; Store at 0x6000000

; Instruction 2: Jump to absolute 0
.LDI $3 #8
.ADD $3 $3 $2
.STQ $7 $3

.JAR $2

:file_not_found
.LDI $0 #0xDEAD
.HLT
