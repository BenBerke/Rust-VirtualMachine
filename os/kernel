; Kernel - wait until A is pressed using keyboard event ring buffer

@text
.LDI $4 #0x52C60    ; queue head address
.LDI $5 #0x52C61    ; queue tail address
.LDI $6 #0x52C62    ; queue data start address

.LDI $1 #0x41       ; ASCII A
.LDI $2 #32         ; queue capacity
.LDI $3 #1          ; increment value

:wait_key
.WFI                ; sleep until an interrupt exists

.LDB $0 $4          ; $0 = head
.LDB $7 $5          ; $7 = tail

.JEQ :wait_key $0 $7 ; if head == tail, queue is empty

; read keycode = queue_data[head]
.ADD $7 $6 $0       ; $7 = queue data address + head
.LDB $7 $7          ; $7 = keycode

; head = (head + 1) % 32
.ADD $0 $0 $3
.MOD $0 $0 $2
.STB $4 $0          ; store new head

; check key
.JEQ :got_a $7 $1

.JMP :wait_key

:got_a
.LDI $0 #0
.HLT