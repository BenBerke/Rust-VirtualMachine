; === Kernel ===
; Loads the HLOL metadata, determines its sector count,
; loads the HLOL source, compiles it, and executes it.
;
; $1 = Stack Pointer. Reserved. Do not modify.
;
; Kernel memory:
;   512 .. 512 + kernel_size
;
; HLOL source memory:
;   0x20000
;
; Compiled HLOL destination:
;   immediately after the loaded kernel

; == Read Kernel Sector Count ==
.LDI $2 #514
.LDW $3 $2 ; $3 = Kernel Sector Count

; == Calculate Compiled HLOL Destination ==
.LDI $5 #9
.SHL $6 $3 $5

.LDI $2 #512
.ADD $6 $6 $2 ; $6 now points immediately after the kernel in RAM

; == Calculate HLOL Metadata Disk Sector ==
.LDI $4 #1
.ADD $4 $4 $3 ; ; $4 now contains the HLOL metadata sector

; == Load HLOL Metadata Sector ==
.LDI $2 #0x20000 ; $2 = temporary metadata destination
.LDI $3 #1 ; Load exactly one metadata sector

.DTM $2 $4 $3

; == Read HLOL Sector Count ==
.LDI $0 #0x20000
.LDW $5 $0 ; $5 = HLOL Source Sector Count

.JZF :hlol_missing $5

; == Move From Metadata Sector to Source Sector ==
.LDI $3 #1
.ADD $4 $4 $3 ; $4 now contains the first HLOL source sector

; == Load HLOL Source ==
.LDI $2 #0x20000
.DTM $2 $4 $5

; == Compiler and Execute HLOL ==
.JMP :compile_hlol
.JAR $6
; $6 MUST POINT TO GENERATED MACHINE CODE

; == Error: HLOL Missing ==
:hlol_missing
.LDI $0 #0xDEAD
.HLT

; ====================
; COMPILER ENTRY POINT
; ====================

:compile_hlol
; Inputs:
;   $2 = HLOL Source Address
;   $6 = Compiled machine code address
; Reserved:
;   $1 = Stack Pointer
; The compiler must write generated instructions starting at $6.

.RET