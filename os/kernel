@text
.LDI $4 #0x52C00    ; keyboard event byte
.LDI $1 #0x41       ; A
.LDI $2 #0          ; zero

:wait_key
.WFI                ; wait until some interrupt exists

.LDB $0 $4          ; read keyboard event
.JZF :wait_key $0   ; interrupt was not keyboard / no key event

.JEQ :got_a $0 $1

.STB $4 $2          ; clear key event
.JMP :wait_key

:got_a
.STB $4 $2
.LDI $0 #0
.HLT